# ============================================================================
# Router - Environment Variable Template
# Copy to .env and fill in real values (never commit .env).
# ============================================================================

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=router
KAFKA_SASL_PASSWORD=CHANGE_ME
KAFKA_SSL_CA_LOCATION=/etc/neurometrix/certs/ca.crt
KAFKA_SSL_CERT_LOCATION=/etc/neurometrix/certs/client.crt
KAFKA_SSL_KEY_LOCATION=/etc/neurometrix/certs/client.key

# Kafka topics
KAFKA_TOPIC_REQUESTS=mri.requests
KAFKA_CONSUMER_GROUP=router-consumer

# PostgreSQL
DATABASE_URL=postgresql://router:CHANGE_ME@postgres:5432/neurometrix
DATABASE_SSLMODE=verify-full
DATABASE_SSL_CERT=/etc/neurometrix/certs/client.crt
DATABASE_SSL_KEY=/etc/neurometrix/certs/client.key
DATABASE_SSL_ROOT_CERT=/etc/neurometrix/certs/ca.crt

# Metrics
METRICS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
